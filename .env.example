# Template for local IDE development. Copy to .env and load it into your run configuration (or
# export manually). Kafka/Redis run via `docker compose up -d`; Postgres is a native local install
# (or `docker compose --profile db up -d`).

SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospio
DB_USERNAME=hospio
DB_PASSWORD=hospio

# Shared by every service: signs and verifies access tokens. At least 48 characters.
JWT_SECRET=local-dev-secret-not-for-production-local-dev-secret
JWT_EXPIRATION_MS=3600000

# Gates the service-to-service /internal/** endpoints on top of the JWT check. Same value everywhere.
INTERNAL_API_KEY=local-dev-internal-key-not-for-production

KAFKA_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=2

# Integrations. "logging" adapters print to the log; real adapters replace them.
POS_PROVIDER=logging
CHANNELS_PROVIDER=logging
STORAGE_TYPE=local
STORAGE_DIR=./storage

# Approval limits (defaults; a hotel's own limits in Hotel setup override them)
MANAGER_SPEND_LIMIT=500000
MANAGER_DISCOUNT_LIMIT=50000
ORG_CREDIT_OWNER_LIMIT=1000000

# Browsers allowed to call the gateway
ALLOWED_ORIGINS=http://localhost:3000,https://sandbox.hospio360.com

# Where each service runs (the gateway and the service-to-service clients read these)
IDENTITY_HOST=localhost
TENANT_HOST=localhost
HOTEL_CONFIG_HOST=localhost
PROPERTY_HOST=localhost
RESERVATION_HOST=localhost
FOLIO_HOST=localhost
PAYMENT_HOST=localhost
FNB_HOST=localhost
HOUSEKEEPING_HOST=localhost
MAINTENANCE_HOST=localhost
INVENTORY_HOST=localhost
FINANCE_HOST=localhost
MESSAGING_HOST=localhost
PLATFORM_HOST=localhost
