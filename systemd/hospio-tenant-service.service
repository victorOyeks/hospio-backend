[Unit]
Description=Hospio360 tenant-service (staging)
After=network.target postgresql.service

[Service]
User=devoyeks
Group=devoyeks
WorkingDirectory=/opt/hospio-staging/tenant-service
EnvironmentFile=/opt/hospio-staging/.env.staging
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/hospio-staging/tenant-service/app.jar
SuccessExitStatus=143
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
