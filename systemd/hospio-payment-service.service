[Unit]
Description=Hospio360 payment-service (staging)
After=network.target postgresql.service
# Enabled on every box, but only runs once CI has shipped a jar for this service.
ConditionPathExists=/opt/hospio-staging/payment-service/app.jar

[Service]
User=devoyeks
Group=devoyeks
WorkingDirectory=/opt/hospio-staging/payment-service
EnvironmentFile=/opt/hospio-staging/.env.staging
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/hospio-staging/payment-service/app.jar
SuccessExitStatus=143
Restart=always
RestartSec=10
# Hard cap: heap 320m + metaspace 160m + code cache 64m + direct 64m + thread stacks and GC ≈ 700M.
MemoryMax=768M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
