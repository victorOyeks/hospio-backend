[Unit]
Description=Hospio360 reservation-service (staging)
After=network.target postgresql.service
# Enabled on every box, but only runs once CI has shipped a jar for this service.
ConditionPathExists=/opt/hospio-staging/reservation-service/app.jar

[Service]
User=devoyeks
Group=devoyeks
WorkingDirectory=/opt/hospio-staging/reservation-service
EnvironmentFile=/opt/hospio-staging/.env.staging
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/hospio-staging/reservation-service/app.jar
SuccessExitStatus=143
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
